#QBL-PRIMITIVE-SPEC v1 ; notation: F=Fibonacci, φ=1.618, i=√-1, prod=u·v, ⊥=orthogonal-rearticulation
#LEGEND op:{Q,B,L} q=(u,v) A=host_class n=global_Q_index N_A=orientations(A) Δ=capacity θ=phase r_n=germ_width

ALPHABET:
  B: q↦sort(v,u+v); θ const            #balanced Fib refine, denom pair
  Q: θ+=π/2 (·i); q const              #quarter-turn
  L: A+=1; q carry UNCHANGED; θ+=π/2    #host lift / ⊥ re-articulation (latch+extend)
  word ∈ {Q,B,L}*

ZEROTH_LIFT: 0D→1D = pure L; creates A=0; endows B,Q @ integer pos; doubles DOF ex nihilo

Q_GEOMETRY:
  orbits radix; no presupposed dim
  4·Q saturate 2D plane → {i,-1,-i,1}
  5th/6th: ⊥-axis rotation → +2 pos (above/below)
  ⇒ 6 distinct quarter-turn orientations
  LATTICE 3×3×3 ⊂ {-1,0,+1}³; admissible = unit-dist(origin) ∧ odd#(quarter-turns)
  P = 6 face-centers; centre=radix(z0); rest=disallowed-repeat

CAPACITY_LAW: Δ = 2^(2n)              #n = global Q-step index
  bits cumulative; per-orientation ceiling enforces Fib depth
  Δ_final(A) = 2^(2·n_final(A))
  N recurrence: N_{A+1}=2·N_A ; ladder N: 6,12,24,48,…
  Δ_final recurrence: Δ_{A+1}=2^(2·N_{A+1})

REFINE: q0=(1,1)→(F_{n+1},F_{n+2}); r_n=1/(F_{n+1}F_{n+2})
  stop-depth n_Δ = Θ(log(1/δ)), δ=1/Δ
  log-form: Bsteps ≈ ½·log_φ(Δ/P0)

DECISION_PROC(A):                      #custody Ξ owns this; no search, no clock, no window
  k=0
  loop:
    (u',v')=B(q)
    if u'·v' < Δ(orientation_k): fire B; goto loop
    elif k < N_A-1: k+=1; fire Q; update Δ; goto loop
    else: fire L                       #saturation: B blocked ∧ all N_A orientations used
  L: A+=1; q carried (floor anchor); θ+=π/2; N,Δ expand

SATURATION ⇔ (B blocked in current orientation) ∧ (Q cycled all N_A)

#=== DOMAIN 0 ===  A=0, q0=(1,1), N=6, thresholds[Δ]=2,4,64,256,1024,4096 =2^{1,2,6,8,10,12}, Δ_final=2^12
