  Q0  2     1  (1,1)→(1,2)                     2
  Q1  4     0  (1,2) [next 6>4]                2
  Q2  64    3  (1,2)→(2,3)→(3,5)→(5,8)        40
  Q3  256   1  (5,8)→(8,13)                   104
  Q4  1024  2  (8,13)→(13,21)→(21,34)         714
  Q5  4096  2  (21,34)→(34,55)→(55,89)       4895
D0.Bsteps_total = 9
D0.floor_anchor = (55,89); prod 55·89=4895 (>4096 ⇒ B blocked)
D0.L1: A→1; carry (55,89); θ+=π/2

